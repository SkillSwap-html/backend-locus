DB_URL=jdbc:postgresql://localhost:5432/locus_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
REDIS_URL=redis://localhost:6379
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SECURITY_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
ADMIN_INITIAL_EMAIL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=local

# Google Maps Platform
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_JAVASCRIPT_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
GOOGLE_MAPS_TIMEOUT_MS=5000

# Google Places API
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_PLACES_TIMEOUT_MS=5000

# Google Routes API
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TIMEOUT_MS=5000

# Google Street View API
GOOGLE_STREET_VIEW_ENABLED=false
GOOGLE_STREET_VIEW_API_KEY=
GOOGLE_STREET_VIEW_BASE_URL=https://maps.googleapis.com
GOOGLE_STREET_VIEW_TIMEOUT_MS=5000

# Gemini API
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2
GEMINI_WEB_SEARCH_ENABLED=false

# Groq é usado como fallback do assistente quando o Gemini falhar
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_TEMPERATURE=0.2

# Amadeus APIs: voos e hospedagem
# real: consulta o provedor configurado; disabled: desliga as rotas sem exibir dados demonstrativos
AMADEUS_ENABLED=true
AMADEUS_MODE=mock
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ACCESS_TOKEN=
AMADEUS_TIMEOUT_MS=10000
